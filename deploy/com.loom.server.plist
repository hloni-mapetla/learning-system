<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs `loom serve` at login and keeps it running.
     Install: edit the paths/URL below, then
       cp deploy/com.loom.server.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.loom.server.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.loom.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/code/learning-system/apps/server/src/cli.ts</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LOOM_PUBLIC_URL</key><string>https://loom.example.com</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/YOU/code/learning-system</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/.loom/server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/.loom/server.log</string>
</dict>
</plist>
